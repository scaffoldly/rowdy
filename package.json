{
  "name": "@scaffoldly/rowdy-cdk",
  "description": "CDK Bindings for Rowdy",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaffoldly/rowdy.git"
  },
  "bugs": {
    "url": "https://github.com/scaffoldly/rowdy/issues"
  },
  "author": "Scaffoldly <github.com/scaffoldly>",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": false,
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22.0",
    "npm": ">=10"
  },
  "engineStrict": false,
  "scripts": {
    "build": "yarn build:index",
    "build:index": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "yarn build",
    "test": "yarn jest -- --verbose --testTimeout=30000"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "**/tests/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "tests/tsconfig.json"
            }
          ]
        },
        "moduleNameMapper": {
          "^@scaffoldly/rowdy-cdk$": "<rootDir>/src/index.ts",
          "^@scaffoldly/rowdy-cdk/otel$": "<rootDir>/src/otel/index.ts"
        }
      }
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "^3.1164.0",
    "@eslint/js": "^9.28.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-aws-sdk": "^0.80.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@smithy/types": "^4.20.0",
    "@types/jest": "^30.0.0",
    "@types/node": ">=22.0.0 <25.0.0",
    "@types/promise-retry": "^1.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "axios": "^1.21.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.2.0",
    "jest": "^30.1.3",
    "pino": "^10.4.0",
    "prettier": "^3.0.0",
    "promise-retry": "^2.0.1",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2"
  }
}
