{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "..",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "paths": {
      "@scaffoldly/rowdy-cdk": ["../src/index"],
      "@scaffoldly/rowdy-cdk/otel": ["../src/otel/index"]
    }
  },
  "include": ["**/*.ts", "../src/**/*.ts"]
}
